APP_NAME="Plant Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development: SQLite. For production switch to mysql and fill the DB_* values.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=plant_care
# DB_USERNAME=plant_care
# DB_PASSWORD=change-me

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Comma-separated allowed browser origins (Flutter Web). Use your real HTTPS domain in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional Redis (docker compose --profile redis up)
REDIS_HOST=redis
REDIS_PORT=6379
PLANTCARE_CATEGORY_ADMINS=demo@plantcare.test
